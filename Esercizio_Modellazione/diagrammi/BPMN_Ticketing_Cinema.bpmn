    <sequenceFlow id="Flow_C02" sourceRef="Task_Cliente_01" targetRef="Task_Cliente_02" />
    <sequenceFlow id="Flow_C03" sourceRef="Task_Cliente_02" targetRef="Task_Cliente_03" />
    <sequenceFlow id="Flow_C04" sourceRef="Task_Cliente_03" targetRef="Task_Cliente_04" />
    <sequenceFlow id="Flow_C05" sourceRef="Task_Cliente_04" targetRef="Gateway_Cliente_01" />
    <sequenceFlow id="Flow_C10" name="No" sourceRef="Gateway_Cliente_01" targetRef="Task_Cliente_07" />
    <sequenceFlow id="Flow_C07" sourceRef="Task_Cliente_05" targetRef="Task_Cliente_06" />
    <sequenceFlow id="Flow_C08" sourceRef="Task_Cliente_06" targetRef="EndEvent_Cliente_Success" />
    <sequenceFlow id="Flow_C06" name="Sì" sourceRef="Gateway_Cliente_01" targetRef="Task_Cliente_05" />
  </process>
  <process id="Process_Sistema" name="Sistema Informatico" isExecutable="false">
    <exclusiveGateway id="Gateway_Sistema_01" name="Posti disponibili?">
      <incoming>Flow_S05</incoming>
      <outgoing>Flow_S06</outgoing>
      <outgoing>Flow_S12</outgoing>
    </exclusiveGateway>
    <task id="Task_Sistema_05" name="Ricevere selezione posto">
