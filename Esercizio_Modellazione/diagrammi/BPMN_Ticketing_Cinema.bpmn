    </endEvent>
    <endEvent id="EndEvent_Sistema_PaymentFail" name="Pagamento fallito">
      <incoming>Flow_S15</incoming>
    </endEvent>
    <startEvent id="StartEvent_Sistema" name="Richiesta accesso">
      <outgoing>Flow_S01</outgoing>
    </startEvent>
    <task id="Task_Sistema_01" name="Autenticare utente">
      <incoming>Flow_S01</incoming>
      <outgoing>Flow_S02</outgoing>
    </task>
    <task id="Task_Sistema_02" name="Mostrare catalogo film">
      <incoming>Flow_S02</incoming>
      <outgoing>Flow_S03</outgoing>
    </task>
    <task id="Task_Sistema_03" name="Ricevere selezione film">
      <incoming>Flow_S03</incoming>
      <outgoing>Flow_S04</outgoing>
    </task>
    <task id="Task_Sistema_04" name="Verificare disponibilità posti">
      <incoming>Flow_S04</incoming>
      <outgoing>Flow_S05</outgoing>
    </task>
    <task id="Task_Sistema_09" name="Notificare indisponibilità">
      <incoming>Flow_S12</incoming>
      <outgoing>Flow_S14</outgoing>
    </task>
    <endEvent id="EndEvent_Sistema_Success" name="Transazione completata">
      <incoming>Flow_S11</incoming>
    </endEvent>
    <task id="Task_Sistema_08" name="Generare e inviare biglietto">
      <incoming>Flow_S10</incoming>
      <outgoing>Flow_S11</outgoing>
    </task>
    <sequenceFlow id="Flow_S05" sourceRef="Task_Sistema_04" targetRef="Gateway_Sistema_01" />
    <sequenceFlow id="Flow_S06" name="Sì" sourceRef="Gateway_Sistema_01" targetRef="Task_Sistema_05" />
    <sequenceFlow id="Flow_S12" name="No" sourceRef="Gateway_Sistema_01" targetRef="Task_Sistema_09" />
