    <messageFlow id="MessageFlow_08" sourceRef="Task_Sistema_08" targetRef="Task_Cliente_06" />
  </collaboration>
  <process id="Process_Cliente" name="Cliente" isExecutable="false">
    <exclusiveGateway id="Gateway_Cliente_02" name="Scegliere alternativa?">
      <incoming>Flow_C09</incoming>
      <outgoing>Flow_C11</outgoing>
      <outgoing>Flow_C12</outgoing>
    </exclusiveGateway>
    <startEvent id="StartEvent_Cliente" name="Acquistiamo un biglietto per un film al Cinema">
      <outgoing>Flow_C01</outgoing>
    </startEvent>
    <task id="Task_Cliente_01" name="Accedere al sistema">
      <incoming>Flow_C01</incoming>
      <outgoing>Flow_C02</outgoing>
    </task>
    <task id="Task_Cliente_02" name="Visualizzare catalogo film">
      <incoming>Flow_C02</incoming>
      <outgoing>Flow_C03</outgoing>
    </task>
    <task id="Task_Cliente_03" name="Selezionare film">
      <incoming>Flow_C03</incoming>
      <incoming>Flow_C11</incoming>
      <outgoing>Flow_C04</outgoing>
    </task>
    <task id="Task_Cliente_04" name="Verificare disponibilità">
      <incoming>Flow_C04</incoming>
      <outgoing>Flow_C05</outgoing>
    </task>
    <task id="Task_Cliente_07" name="Valutare alternative">
      <incoming>Flow_C10</incoming>
      <outgoing>Flow_C09</outgoing>
    </task>
    <endEvent id="EndEvent_Cliente_Cancel" name="Acquisto annullato">
      <incoming>Flow_C12</incoming>
    </endEvent>
    <task id="Task_Cliente_06" name="Ricevere biglietto via email">
      <incoming>Flow_C07</incoming>
      <outgoing>Flow_C08</outgoing>
    </task>
    <endEvent id="EndEvent_Cliente_Success" name="Biglietto acquistato">
      <incoming>Flow_C08</incoming>
    </endEvent>
    <task id="Task_Cliente_05" name="Selezionare posto e confermare">
      <incoming>Flow_C06</incoming>
      <outgoing>Flow_C07</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Cliente_01" name="Posti disponibili?">
      <incoming>Flow_C05</incoming>
      <outgoing>Flow_C06</outgoing>
      <outgoing>Flow_C10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_C09" sourceRef="Task_Cliente_07" targetRef="Gateway_Cliente_02" />
    <sequenceFlow id="Flow_C11" name="Sì" sourceRef="Gateway_Cliente_02" targetRef="Task_Cliente_03" />
    <sequenceFlow id="Flow_C12" name="No" sourceRef="Gateway_Cliente_02" targetRef="EndEvent_Cliente_Cancel" />
