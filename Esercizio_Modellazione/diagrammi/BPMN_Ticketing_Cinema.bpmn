      <outgoing>Flow_S08</outgoing>
    </task>
    <task id="Task_Sistema_07" name="Ricevere esito pagamento">
      <incoming>Flow_S08</incoming>
      <outgoing>Flow_S09</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Sistema_02" name="Pagamento OK?">
      <incoming>Flow_S09</incoming>
      <outgoing>Flow_S10</outgoing>
      <outgoing>Flow_S13</outgoing>
    </exclusiveGateway>
    <task id="Task_Sistema_10" name="Annullare prenotazione">
      <incoming>Flow_S13</incoming>
      <outgoing>Flow_S15</outgoing>
